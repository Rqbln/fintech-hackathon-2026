# ── LLM: Cerebras inference (zai-glm-4.7, OpenAI-compatible) ─────────────────
CEREBRAS_API_KEY=your-cerebras-api-key
# CEREBRAS_MODEL: analysis/remediation/report LLM (100 RPM, 8k ctx) — default: llama3.1-8b
# CEREBRAS_EXTRACTION_MODEL: extraction-only LLM (5 RPM, 65k ctx) — default: qwen-3-235b-a22b-instruct-2507

# ── Embeddings: Gemini Embedding 2 ───────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBED_MODEL=models/gemini-embedding-2
GEMINI_EMBED_DIM=768

# ── GCP / Vertex AI Vector Search ────────────────────────────────────────────
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1    # only region supporting Vector Search v2
# Vertex AI Vector Search v2.0 collection name (created by seed_dora.py)
VERTEX_AI_VS_COLLECTION=dora-analyst-docs
# Leave empty to let the SDK create the collection on first run
VERTEX_AI_VS_ENDPOINT_ID=

# ── GCS document storage ─────────────────────────────────────────────────────
GCS_BUCKET=your-gcs-bucket-name

# ── Neo4j (AuraDB on GCP or local docker-compose) ────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── LlamaParse (optional — falls back to PyMuPDF if not set) ─────────────────
LLAMA_PARSE_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TRACES_DIR=./traces
